# [Benjamin - #08, 2026-10-15] Modele de configuration pour docker compose.
# Copier ce fichier en ".env" (jamais commite : voir .gitignore) et remplacer les valeurs.
DB_USER=educmanager
DB_PASSWORD=changez-moi-postgres
MONGO_USER=educmanager
MONGO_PASSWORD=changez-moi-mongo
# 32 caracteres minimum ; generer par exemple avec : openssl rand -base64 48
JWT_SECRET=changez-moi-avec-un-secret-de-plus-de-32-caracteres
# true = cree les comptes et donnees de demonstration au premier demarrage (base vide)
APP_SEED_ENABLED=true
APP_PORT=8081
CORS_ORIGINS=http://localhost:8081
